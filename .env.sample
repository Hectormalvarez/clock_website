# Copy to .env (dev stack) and/or .env.prod (production stack).
# Both files are gitignored. Every value below has a safe default except the
# tunnel token and the webhook token, which must be set per environment.

# ── Host port overrides ─────────────────────────────────────────
# Dev: the edge proxy port on the host. http://localhost:8100
NGINX_HOST_PORT=8100

# Prod: the loopback-only port used by `make prod-verify` and the host tunnel.
PROD_VERIFY_PORT=9418

# ── Cloudflare Tunnel ───────────────────────────────────────────
# Dev stack:  set it in .env      → started by `make dev-tunnel-up`
# Prod stack: set it in .env.prod → started by `make prod-deploy`
#
# Use a DIFFERENT tunnel (different token) per environment. Sharing one token
# registers two connectors on the same tunnel and Cloudflare will load-balance
# visitors across the dev and prod stacks.
#
# The tunnel's public hostname must target the edge by service name:
#   http://nginx:8080
CLOUDFLARE_TUNNEL_TOKEN=

# ── Webhook (production only) ───────────────────────────────────
# Generate with: openssl rand -hex 32
# Must match the WEBHOOK_TOKEN GitHub secret.
WEBHOOK_TOKEN=

# ── GHCR image references (production only) ─────────────────────
REGISTRY_OWNER=hectormalvarez
IMAGE_TAG=latest

# ── Public site origin ──────────────────────────────────────────
# Baked into <link rel="canonical">, og:url, sitemap.xml and robots.txt at
# build time. Empty falls back to http://localhost:8100 (see vite.config.ts).
#
#   Local production build:  cd web && VITE_SITE_URL=https://… npm run build
#   Production images:       set the SITE_URL *repository variable* in GitHub
#                            (release.yml passes it as a build arg)
VITE_SITE_URL=
