# Production image — compiles the app, then serves the static bundle with the
# unprivileged nginx image (non-root, listens on 8080, no capabilities needed).

# ── Build stage ───────────────────────────────────────────────────
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder

WORKDIR /app

# Public origin baked into canonical/Open Graph URLs and sitemap.xml.
# Empty (the default) falls back to http://localhost:8100 in vite.config.ts.
ARG VITE_SITE_URL
ENV VITE_SITE_URL=$VITE_SITE_URL

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Runtime stage ─────────────────────────────────────────────────
# nginxinc/nginx-unprivileged runs as a non-root user and listens on 8080,
# which is why the edge proxy targets web:8080 in every environment.
FROM nginxinc/nginx-unprivileged:1.30-alpine@sha256:adf5042a17f4ecdd200c595fa9ffd1be37efb18f89a830bd1a00e4ab4d59d42c AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

# Probe the static server directly; the edge has its own /healthz.
# Exec form (not shell) so wget's exit status is the health status.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
	CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/healthz"]

CMD ["nginx", "-g", "daemon off;"]
